# Postgres connection string for the local pgvector database in docker-compose.yml.
DATABASE_URL="postgresql://reposage:reposage@localhost:5432/reposage"

# Redis connection string for the local Redis instance in docker-compose.yml.
REDIS_URL="redis://localhost:6379"

# Groq API key for the primary chat LLM provider.
GROQ_API_KEY="replace-with-your-groq-api-key"

# Google AI Studio API key for Gemini fallback or optional embedding modes.
GOOGLE_AI_API_KEY="replace-with-your-google-ai-api-key"

# Clerk publishable key for browser-side authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="replace-with-your-clerk-publishable-key"

# Clerk secret key for server-side authentication.
CLERK_SECRET_KEY="replace-with-your-clerk-secret-key"

# Clerk route URLs.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app"
