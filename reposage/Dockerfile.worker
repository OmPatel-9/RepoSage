FROM node:22-slim

RUN apt-get update && apt-get install -y \
    git \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm directly — more reliable in Docker than corepack
RUN npm install -g pnpm@11.1.2

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

# --ignore-scripts skips native postinstall builds that can fail without headers;
# tree-sitter is loaded lazily at runtime so this is safe.
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .

CMD ["pnpm", "exec", "tsx", "src/worker/index.ts"]
